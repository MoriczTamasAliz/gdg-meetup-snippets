# DO NOT SOURCE THIS FILE.
#
# These flags are off by default for a reason. Turning them on ships prompt text,
# model responses, tool arguments and tool output to your observability backend —
# including anything a developer pasted into a prompt, which is where credentials
# end up. Enable them deliberately, for a named debugging window, on a backend
# you have checked the retention policy of.
#
# export OTEL_LOG_USER_PROMPTS=1
# export OTEL_LOG_ASSISTANT_RESPONSES=1
# export OTEL_LOG_TOOL_DETAILS=1
# export OTEL_LOG_TOOL_CONTENT=1
# export OTEL_LOG_RAW_API_BODIES=1
#
# Content-bearing attributes are truncated at 60 KB by default:
# export CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH=61440
