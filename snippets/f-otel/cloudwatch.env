# Path 1: straight to CloudWatch, no collector.
# Create the bearer token as a CloudWatch metrics API key against an IAM user
# holding CloudWatchAPIKeyAccess. It is a long-term credential: prefer SigV4
# where you are already inside AWS, and never commit it.

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=http/json
export OTEL_EXPORTER_OTLP_ENDPOINT=https://monitoring.eu-west-1.amazonaws.com
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer ${CLOUDWATCH_METRICS_TOKEN}"

# These become PromQL labels, and they are what makes showback possible.
export OTEL_RESOURCE_ATTRIBUTES="department=engineering,team.id=platform,cost_center=eng-123"

# Repository identity is off by default; turn it on to slice cost by repo.
export OTEL_METRICS_INCLUDE_REPOSITORY=true
