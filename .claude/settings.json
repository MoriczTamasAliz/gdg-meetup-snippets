{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/snippets/c-guardrails/guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking the guardrails..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/snippets/d-change-report/change_report.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
